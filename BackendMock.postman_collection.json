{
  "info": {
    "name": "BackendMock API",
    "description": "Mock backend API server (Node.js + Express) with token expiration. Login auto-saves the access token. Refresh token được set vào HttpOnly cookie (Postman tự lưu/gửi qua cookie jar).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" },
    { "key": "token", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Login",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"123456\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "login"]
        },
        "description": "Đăng nhập. Tài khoản mẫu: admin / user / guest (password: 123456)."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "    const json = pm.response.json();",
              "    if (json.token) pm.collectionVariables.set('token', json.token);",
              "    console.log('Token saved:', json.token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Refresh Token",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/auth/refresh",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "refresh"]
        },
        "description": "Cấp access token mới. Refresh token đọc từ HttpOnly cookie (Postman tự gửi qua cookie jar) — không cần body."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "    const json = pm.response.json();",
              "    if (json.token) pm.collectionVariables.set('token', json.token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Logout",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/auth/logout",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "logout"]
        },
        "description": "Thu hồi refresh token ở server + xóa cookie. Postman tự gửi cookie qua cookie jar."
      }
    },
    {
      "name": "4. Get Products",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/products?name=&category=",
          "host": ["{{baseUrl}}"],
          "path": ["api", "products"],
          "query": [
            { "key": "name", "value": "", "description": "Lọc theo tên (chứa)" },
            { "key": "category", "value": "", "description": "Lọc theo category" }
          ]
        },
        "description": "Danh sách sản phẩm. Cần token. Hỗ trợ lọc theo name & category."
      }
    },
    {
      "name": "5. Create Product",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Sản phẩm mới\",\n  \"price\": 199000,\n  \"category\": \"Điện tử\",\n  \"status\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/products",
          "host": ["{{baseUrl}}"],
          "path": ["api", "products"]
        },
        "description": "Tạo sản phẩm mới. Cần token."
      }
    },
    {
      "name": "6. Dashboard",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/dashboard",
          "host": ["{{baseUrl}}"],
          "path": ["api", "dashboard"]
        },
        "description": "Thống kê dashboard (10 fields). Cần token."
      }
    }
  ]
}
